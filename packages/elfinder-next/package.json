{
  "name": "elfinder-next",
  "version": "0.2.0",
  "description": "elFinder 2.1 connector for Next.js App Router API routes",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "elfinder",
    "nextjs",
    "file-manager",
    "connector"
  ],
  "homepage": "https://github.com/alperkosay/elfinder-next/tree/main/packages/elfinder-next#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alperkosay/elfinder-next.git",
    "directory": "packages/elfinder-next"
  },
  "bugs": {
    "url": "https://github.com/alperkosay/elfinder-next/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.3.0"
  },
  "packageManager": "pnpm@10.32.1",
  "peerDependencies": {
    "next": ">=14"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "mime-types": "^3.0.1",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22",
    "next": "^16.2.6",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.2"
  }
}
